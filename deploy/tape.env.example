# /etc/tape/tape.env on the box. Every job reads it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/tape?sslmode=require   # Neon direct (unpooled) connection
TELEGRAM_BOT_TOKEN=                       # the twitter-checker bot
TELEGRAM_CHAT_ID=                         # the new Tape channel
SITE_URL=https://tape-nick-21c4.vercel.app  # the public site; used in alert and daily-post links
CHART_STORE=db                            # db | s3 | local
# With CHART_STORE=s3 (e.g. Cloudflare R2), also:
# S3_BUCKET=tape-charts
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE=https://charts.example.com   (also set on Vercel)
