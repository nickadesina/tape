{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 800,
      "excludeFiles": "{site/**,tests/**,deploy/**,docs/**,research/**,.github/**,var/**}"
    }
  },
  "crons": [
    {
      "path": "/api/shift",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/stress",
      "schedule": "30 20 * * 0"
    },
    {
      "path": "/api/stress",
      "schedule": "30 21 * * 0"
    },
    {
      "path": "/api/model",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/load",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/rents",
      "schedule": "5 * * * *"
    }
  ]
}
