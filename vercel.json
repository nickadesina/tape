{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 800,
      "excludeFiles": "{site/**,tests/**,deploy/**,docs/**,.github/**,var/**}"
    }
  },
  "crons": [
    {
      "path": "/api/shift",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "0 21 * * *"
    }
  ]
}
